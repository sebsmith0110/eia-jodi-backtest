# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tooling caches
.pytest_cache/
.ruff_cache/
.DS_Store

# Raw downloads are too big for git; the hosted dashboard reads the snapshot
data/*
!data/.gitkeep
# Small clean-table snapshot the hosted dashboard reads (etl/snapshot.py)
!data/snapshot/
# Quality run logs: row counts and check results per run (etl/quality.py)
!data/logs/
.env
